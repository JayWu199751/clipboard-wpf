<Window x:Class="ClipboardTool.Presentation.Wpf.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipboardTool"
        Width="473" Height="945"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Sans}">

    <Window.Resources>
        <!-- 卡片容器：CornerRadius12、1 DIP 细线（Border.Subtle）、上下12/左右16；hover 仅细边加深 -->
        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                Margin="0,0,0,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外壳：四边 1 DIP 安全留白，2 DIP #757575 实线，36 DIP 圆角，两主题同色。
         WPF Border 的绘制顺序是背景→描边→子内容：通栏页脚的方角会伸进描边内圆角的角落扇区、
         从内侧盖掉弧线，故内层三行 Grid（ShellRows，原点=描边内缘）按内圆角 r34 裁剪，
         等价原型的 overflow:hidden；描边本身不在被裁子树中，保持完整。 -->
    <Grid Margin="1" Background="Transparent">
        <Border CornerRadius="36"
                BorderThickness="2"
                BorderBrush="{DynamicResource Brush.Window.Ring}"
                Background="{DynamicResource Brush.App}">
            <Grid x:Name="ShellRows" SizeChanged="OnShellRowsSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- 搜索头：左右 12 DIP，搜索井高 36 胶囊（半径=高一半），图标 15，主题按钮 24/图标 15，键名 chip -->
                <Grid Grid.Row="0" Margin="12,0">
                    <Border Height="36"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Input}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="12,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="14" Height="14"
                                             Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.75" />
                                    <Line X1="15.8" Y1="15.8" X2="21" Y2="21"
                                          Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>

                            <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox"
                                         FontSize="13.5"
                                         FontWeight="Medium"
                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                         CaretBrush="{DynamicResource Brush.Text.Primary}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Padding="0" />
                                <TextBlock Text="搜索"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 主题按钮占位：24 按钮/15 图标（三态切换逻辑归 T07） -->
                            <Border Grid.Column="2" Width="24" Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="12" RadiusX="2" RadiusY="2"
                                                   Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.75" />
                                        <Line X1="9" Y1="20.5" X2="15" Y2="20.5"
                                              Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- 键名 chip（搜索键的家，legacy「提示 = 行为」）：T04 键位注册表接入前隐藏 -->
                            <Border Grid.Column="3" Height="18" MinWidth="18"
                                    Margin="8,0,0,0"
                                    CornerRadius="5"
                                    Padding="5,0"
                                    Background="{DynamicResource Brush.Input}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="1,1,1,2"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SearchKeyText}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 列表：上左右 12、下 16，卡片间 8；虚拟化 + 回收；原生滚动条隐藏（自绘指示条归后续工单） -->
                <ListBox Grid.Row="1"
                         Margin="12,12,12,16"
                         ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource CardContainerStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionMode="Single">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Body}"
                                           FontSize="13"
                                           LineHeight="20.15"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Meta}"
                                           Margin="0,8,0,0"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="10.5"
                                           LineHeight="16"
                                           LineStackingStrategy="BlockLineHeight"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 页脚：左右 16、顶部细分隔线、mono 10.5；组间 8、组内 4，chip 高 16/字 9.5 -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        Background="{DynamicResource Brush.App}"
                        Padding="16,0">
                    <Grid>
                        <TextBlock Text="{Binding CountText}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- 页脚只列面板可见时真实生效的键（F45；呼出键展示归托盘菜单）：浏览态 Esc 停靠（F18） -->
                            <StackPanel Orientation="Horizontal">
                                <Border Height="16" MinWidth="18" CornerRadius="5" Padding="5,0"
                                        Background="{DynamicResource Brush.Input}"
                                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DockKeyText}"
                                               FontFamily="{StaticResource Font.Mono}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="停靠"
                                           Margin="4,0,0,0"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
