<Window x:Class="ClipboardTool.Presentation.Wpf.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardTool.Presentation.Wpf"
        xmlns:panelModes="clr-namespace:ClipboardTool.Domain.PanelModes;assembly=ClipboardTool.Domain"
        Title="ClipboardTool"
        Width="473" Height="945"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Sans}">

    <Window.Resources>
        <!-- 备注编辑：卡片 Id == 视图模型 NoteEditingId 时显示内联编辑框，meta 行在非编辑时显示（两态等高，F47） -->
        <local:EqualityToVisibilityConverter x:Key="EqualityToVisibility" />
        <local:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" />
        <local:CompactValueConverter x:Key="CompactValue" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 图卡棋盘格底（F42）：16 DIP 瓦片 = 8 DIP 方格 ×2，方格色 Brush.Thumb.Checker 随主题；
             渐变底 #2A2A40→#1A1A24 为 design-system 钉死的写死色值（两主题共用，不做 token 化） -->
        <LinearGradientBrush x:Key="Thumb.Base" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#2A2A40" />
            <GradientStop Offset="1" Color="#1A1A24" />
        </LinearGradientBrush>
        <DrawingBrush x:Key="Thumb.Checker"
                      TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource Thumb.Base}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource Brush.Thumb.Checker}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 卡片容器：CornerRadius12、1 DIP 细线（Border.Subtle）、上下12/左右16；hover 仅细边加深。
             Padding/Margin 显式清零 + Stretch：ListBoxItem 默认 Padding=1 会让卡片内缩、
             右细线在 175% DPI 的亚像素相位下被背景吞掉，左右边距不再对称 -->
        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                Margin="0,0,0,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Selection.Background}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外壳：四边 1 DIP 安全留白，2 DIP #757575 实线，36 DIP 圆角，两主题同色。
         WPF Border 的绘制顺序是背景→描边→子内容：通栏页脚的方角会伸进描边内圆角的角落扇区、
         从内侧盖掉弧线，故内层三行 Grid（ShellRows，原点=描边内缘）按内圆角让位裁剪；
         描边之外再补描一层同样的环（不参与命中测试）：描边外圈抗锯齿像素与窗外桌面混合，
         桌面亮暗会让圆角观感粗细不一，双层叠涂使 fringe 趋于不透明，四角粗细一致 -->
    <Grid Margin="1" Background="Transparent">
        <Border CornerRadius="36"
                BorderThickness="2"
                BorderBrush="{DynamicResource Brush.Window.Ring}"
                Background="{DynamicResource Brush.App}">
            <Grid x:Name="ShellRows" SizeChanged="OnShellRowsSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- 搜索头：左右 12 DIP，搜索井高 36 胶囊（半径=高一半），图标 15，清除 16/图标 10，主题按钮 24/图标 15，键名 chip。
                     浏览态输入框只读（模式在主进程侧，legacy SearchHeader readOnly 同语义），点击井 = 进搜索 -->
                <Grid Grid.Row="0" Margin="12,0">
                    <Border x:Name="SearchWell"
                            Height="36"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Input}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="12,0,8,0"
                            PreviewMouseLeftButtonDown="OnSearchWellPress">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="3.5" Canvas.Top="3.5" Width="14" Height="14"
                                             Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.75" />
                                    <Line X1="15.8" Y1="15.8" X2="21" Y2="21"
                                          Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>

                            <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBox x:Name="SearchBox"
                                         FontSize="13.5"
                                         FontWeight="Medium"
                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                         CaretBrush="{DynamicResource Brush.Text.Primary}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         Padding="0"
                                         IsReadOnly="True"
                                         AutomationProperties.Name="{x:Static local:AccessibilityNames.SearchInput}"
                                         TextChanged="OnSearchBoxTextChanged" />
                                <TextBlock Text="{Binding PlaceholderText}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- 清除按钮：仅搜索态且有查询时出现；点击清查询并保留输入焦点（F23）；
                                 纯图形无文本，F48 显式命名；Focusable=False 与 legacy 一致（鼠标专用，
                                 焦点留在搜索框），IsFocused 触发器保留为完整视觉状态 -->
                            <Button x:Name="SearchClear"
                                    Grid.Column="2"
                                    Width="16" Height="16"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Focusable="False"
                                    AutomationProperties.Name="{x:Static local:AccessibilityNames.SearchClear}"
                                    PreviewMouseLeftButtonDown="OnSearchClearPress">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ClearBg"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                BorderBrush="Transparent">
                                            <Viewbox Width="10" Height="10">
                                                <Canvas Width="24" Height="24">
                                                    <Line X1="5" Y1="5" X2="19" Y2="19"
                                                          Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="2.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Line X1="19" Y1="5" X2="5" Y2="19"
                                                          Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="2.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClearBg" Property="Background" Value="{DynamicResource Brush.Bg.Active}" />
                                            </Trigger>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter TargetName="ClearBg" Property="BorderBrush" Value="{DynamicResource Brush.Border.Selected}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- 主题按钮占位：24 按钮/15 图标（三态切换逻辑归 T07） -->
                            <Border Grid.Column="3" Width="24" Height="24"
                                    CornerRadius="12"
                                    VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Rectangle Canvas.Left="3" Canvas.Top="5" Width="18" Height="12" RadiusX="2" RadiusY="2"
                                                   Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.75" />
                                        <Line X1="9" Y1="20.5" X2="15" Y2="20.5"
                                              Stroke="{DynamicResource Brush.Text.Secondary}" StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <!-- 键名 chip（搜索键的家，legacy「提示 = 行为」）：文本由键位注册表推导，搜索态收起 -->
                            <Border Grid.Column="4" Height="18" MinWidth="18"
                                    Margin="8,0,0,0"
                                    CornerRadius="5"
                                    Padding="5,0"
                                    Background="{DynamicResource Brush.Input}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="1,1,1,2"
                                    Visibility="{Binding SearchKeyChipVisible}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SearchKeyText}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="10.5"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 列表：上左右 12、下 16，卡片间 8；虚拟化 + 回收。
                     原生滚动条隐藏且不占位（对齐原型 scrollbar-width:none）：Hidden 仅不绘制、
                     仍按滚动条期望宽度压缩视口，导致卡片右缘被裁、右细线消失，故将宽度钳为 0；
                     自绘滚动指示条归后续工单 -->
                <ListBox x:Name="HistoryList"
                         Grid.Row="1"
                         Margin="12,12,12,16"
                         ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource CardContainerStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         AutomationProperties.Name="{x:Static local:AccessibilityNames.HistoryList}"
                         PreviewMouseDoubleClick="OnCardDoubleClick"
                         SelectionChanged="OnListSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.CacheLength="1,1"
                         VirtualizingPanel.CacheLengthUnit="Item"
                         SelectionMode="Single">
                    <ListBox.Resources>
                        <!-- 隐藏滚动条且不占布局（Collapsed 而非 Hidden：后者仍保留轨道宽度，
                             会把视口压窄、与卡片左右边距不对称）；滚动仍由 ScrollViewer 处理 -->
                        <Style TargetType="ScrollBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- 缩略图（F42）：150 DIP contain 居中、6 DIP 圆角、棋盘格底、1 DIP 细线；
                                     仅图片卡渲染；共享缓存按 Id 记忆化（P4 结论），宿主做 id/代次防错图 -->
                                <local:ThumbnailHost Height="150"
                                                     Margin="0,0,0,12"
                                                     Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}"
                                                     Background="{StaticResource Thumb.Checker}"
                                                     BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                     BorderThickness="1"
                                                     Cache="{Binding DataContext.Thumbnails, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     EntryId="{Binding Id}"
                                                     ImagePath="{Binding ImagePath}" />
                                <!-- 文件名行（F42）：mono 12 号单行省略；缩略图→文件名的 12 DIP 间距归缩略图 Margin -->
                                <TextBlock Text="{Binding FileName}"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                                <!-- 正文最多三行裁剪（原型 line-clamp；完整正文在备注/粘贴里原样，F01）；
                                     命中片段 accent-soft 底色（F23，附加属性渲染高亮 Run）；图片卡正文区收起 -->
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="local:HighlightText.Spans" Value="{Binding Spans}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="LineHeight" Value="20.15" />
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                            <Setter Property="MaxHeight" Value="60.45" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- meta 行（F42/F24/F47）：时间·图钉·备注 单行省略，高 16；
                                     编辑中整行让位给内联编辑框（两层等高 → 卡片与滚动几何零位移） -->
                                <Grid Height="16" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Visibility>
                                            <MultiBinding Converter="{StaticResource EqualityToVisibility}" ConverterParameter="Invert">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.NoteEditingId"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </StackPanel.Visibility>
                                        <TextBlock Text="{Binding Meta}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="10.5"
                                                   LineHeight="16"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                        <!-- 图钉（F24：HUD 只以图钉显示，无独立置顶分组标题）；段间「·」分隔随段显隐 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding Pinned, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="·"
                                                       Margin="6,0,0,0"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <Viewbox Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M12 17v5"
                                                          Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.75"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                    <Path Data="M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"
                                                          Stroke="{DynamicResource Brush.Text.Tertiary}" StrokeThickness="1.75"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </StackPanel>
                                        <!-- 内联备注（非空时显示；全文悬停提示 F42；命中高亮 F23） -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="·"
                                                       Margin="6,0,0,0"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" />
                                            <TextBlock local:HighlightText.Spans="{Binding NoteSpans}"
                                                       ToolTip="{Binding Note}"
                                                       Margin="6,0,0,0"
                                                       FontSize="10.5"
                                                       LineHeight="16"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- 内联备注编辑框（F07）：与 meta 行同高 16；描边外 3 DIP 柔光环（单一圈，
                                         上下各溢出 4 DIP 绘制余量，不参与布局）；MaxLength=UTF-16 上限，
                                         存储侧 Rune 归一化兜底（F07 与 04 票存储语义对齐） -->
                                    <Border Margin="0,-4"
                                            BorderThickness="3"
                                            BorderBrush="{DynamicResource Brush.Ring.Soft}"
                                            CornerRadius="6"
                                            Background="Transparent">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource EqualityToVisibility}">
                                                <Binding Path="Id" />
                                                <Binding Path="DataContext.NoteEditingId"
                                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </Border.Visibility>
                                        <TextBox x:Name="NoteBox"
                                                 Height="16"
                                                 Text="{Binding DataContext.NoteDraft, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="10.5"
                                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                                 CaretBrush="{DynamicResource Brush.Text.Primary}"
                                                 Background="{DynamicResource Brush.Input}"
                                                 BorderBrush="{DynamicResource Brush.Border.Selected}"
                                                 BorderThickness="1"
                                                 Padding="7,0"
                                                 VerticalContentAlignment="Center"
                                                 MaxLength="{x:Static panelModes:PanelFooterRegistry.MaxNoteLength}"
                                                 AutomationProperties.Name="{x:Static local:AccessibilityNames.NoteEditor}"
                                                 FocusVisualStyle="{x:Null}"
                                                 PreviewKeyDown="OnNoteBoxKeyDown"
                                                 LostFocus="OnNoteBoxLostFocus"
                                                 IsVisibleChanged="OnNoteBoxVisibleChanged" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态（F23）：无历史与无匹配是两个说法 -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding EmptyVisible}">
                    <TextBlock Text="{Binding EmptyText}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <!-- toast 栈（F46）：居中胶囊，高 34，下距 48，多条竖排；
                     成功绿勾/错误红叉（i-check/i-x 同族图形）+ 消息 + 次级 dim + 可选动作（撤销）；
                     离场淡出 160ms，生命周期由窗口计时管理（撤销 toast 6s 与删除窗口同步） -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding Toasts}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Margin="0,0,0,48"
                              IsHitTestVisible="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- F48：Message 文本块锚定播报（Name=Announcement 含错误前缀/动作/dim，
                                 LiveSetting=Polite 让 Narrator 主动播报状态）；普通 Border 无 peer，
                                 播报必须锚在有 peer 的文本块上 -->
                            <Border Height="34"
                                    Padding="14,0,8,0"
                                    Margin="0,4,0,0"
                                    CornerRadius="17"
                                    Background="{DynamicResource Brush.Input}"
                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                    BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <!-- 入场（F46 入栈 240ms 淡入）：Entering 置 False 触发；
                                                 Animated=False（系统减少动态 F48）时不藏起也不播动画，直接可见 -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Entering}" Value="True" />
                                                    <Condition Binding="{Binding Animated}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0" />
                                                <MultiDataTrigger.ExitActions>
                                                    <!-- BeginStoryboard.Storyboard 只接受 Storyboard 类型，动画必须包一层（否则模板解析炸、炸断整条刷新链） -->
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="1" Duration="0:0:0.24" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <!-- 离场：Animated=True 走 160ms 淡出；False 直接消失（随后由窗口移除） -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Leaving}" Value="True" />
                                                    <Condition Binding="{Binding Animated}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0" />
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0" Duration="0:0:0.16" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Leaving}" Value="True" />
                                                    <Condition Binding="{Binding Animated}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Opacity" Value="0" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <!-- 勾（成功绿） -->
                                            <Path Data="m20 6.5-11 11-5-5"
                                                  Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <!-- 叉（错误红） -->
                                            <Path Data="M18 6 6 18M6 6l12 12"
                                                  Stroke="{DynamicResource Brush.Error}" StrokeThickness="1.75"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Message}"
                                               Margin="8,0,0,0"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding Announcement}"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Dim}"
                                               Margin="6,0,0,0"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               Visibility="{Binding Dim, Converter={StaticResource StringNotEmptyToVisibility}}" />
                                    <Button Click="OnToastAction"
                                            Margin="8,0,0,0"
                                            Padding="10,3"
                                            FontSize="12"
                                            Cursor="Hand"
                                            Content="{Binding ActionLabel}"
                                            Visibility="{Binding ActionLabel, Converter={StaticResource StringNotEmptyToVisibility}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ToastActionBg"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                        BorderThickness="1"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      TextBlock.Foreground="{DynamicResource Brush.Accent.Text}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ToastActionBg" Property="Background" Value="{DynamicResource Brush.Bg.Active}" />
                                                    </Trigger>
                                                    <!-- F48 键盘焦点环：撤销按钮可被键盘聚焦时显示完整环 -->
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="ToastActionBg" Property="BorderBrush" Value="{DynamicResource Brush.Accent.Text}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 页脚：左右 16、顶部细分隔线、mono 10.5；左侧计数，右侧键位提示（组间 8、组内 4，chip 高 16/字 9.5）
                     数据源 = 键位注册表按面板模式生成（F45/F20），未生效的键不展示（提示 = 行为）；
                     ≤340 DIP 窄档收紧（F47）：左右 10、文字 9.5、组距 3 -->
                <Border x:Name="FooterHost"
                        Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        Background="{DynamicResource Brush.App}"
                        SizeChanged="OnFooterSizeChanged"
                        Padding="{Binding FooterCompact, Converter={StaticResource CompactValue}, ConverterParameter='16,0|10,0'}">
                    <Grid>
                        <TextBlock Text="{Binding CountText}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                        <!-- 右侧（F45）：焦点错误覆盖普通组；备注态为 保存/取消/字数 三段；
                             键名一律来自 PanelFooterRegistry 注册表（提示 = 行为，不写字面键名） -->
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding FooterHints}"
                                          AlternationCount="{Binding FooterHints.Count}"
                                          Visibility="{Binding FooterHintsVisible}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin"
                                                Value="{Binding DataContext.FooterCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompactValue}, ConverterParameter='8,0,0,0|3,0,0,0'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="0">
                                                <Setter Property="Margin" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 键名 chip：字数段（IsCount）不画 chip -->
                                            <Border Height="16" MinWidth="18" CornerRadius="5" Padding="5,0"
                                                    Background="{DynamicResource Brush.Input}"
                                                    BorderBrush="{DynamicResource Brush.Border.Strong}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCount}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Keys}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="9.5"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Action}"
                                                       Margin="4,0,0,0"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="{Binding DataContext.FooterCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompactValue}, ConverterParameter='10.5|9.5'}"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                       VerticalAlignment="Center" />
                                            <!-- 字数段（备注态 n/200）：纯文本无 chip -->
                                            <TextBlock Text="{Binding Keys}"
                                                       Margin="4,0,0,0"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="{Binding DataContext.FooterCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource CompactValue}, ConverterParameter='10.5|9.5'}"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCount}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FooterStatus}"
                                       Visibility="{Binding FooterErrorVisible}"
                                       FontFamily="{StaticResource Font.Mono}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Brush.Error}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>
                <!-- 捕获覆盖层（F31）：捕获态全让位（全局键由状态机注销），录入新呼出键的编辑器层。
                     提示文案与状态由宿主按判定结果下发；Esc 取消在窗口级 PreviewKeyDown 拦截 -->
                <Grid x:Name="CaptureOverlay"
                      Grid.Row="0" Grid.RowSpan="3"
                      Background="{DynamicResource Brush.App}"
                      Visibility="Collapsed"
                      IsHitTestVisible="True">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320">
                        <TextBlock Text="按下新的快捷键组合"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="需要包含 Ctrl / Alt / Win 修饰键"
                                   Margin="0,8,0,0"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock x:Name="CaptureStatusText"
                                   Margin="0,16,0,0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   AutomationProperties.Name="{x:Static local:AccessibilityNames.CaptureStatus}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="Esc 取消"
                                   Margin="0,16,0,0"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="10.5"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 描边补描层（最上层）：与主描边同环，fringe 叠涂后四角粗细一致；不参与命中测试 -->
        <Border CornerRadius="36"
                BorderThickness="2"
                BorderBrush="{DynamicResource Brush.Window.Ring}"
                Background="Transparent"
                IsHitTestVisible="False" />
    </Grid>
</Window>
