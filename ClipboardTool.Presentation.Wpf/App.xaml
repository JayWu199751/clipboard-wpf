<Application x:Class="ClipboardTool.Presentation.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 三态主题偏好（跟随系统/明/暗）的切换归 T07；骨架默认暗色 -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 普通文字使用系统微软雅黑（ADR-0001 决策 3）；等宽字体保留现有系统回退链。 -->
            <FontFamily x:Key="Font.Sans">Microsoft YaHei, Segoe UI</FontFamily>
            <FontFamily x:Key="Font.Mono">JetBrains Mono, Cascadia Code, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
