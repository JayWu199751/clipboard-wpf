<Window x:Class="P1FocusProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P1 焦点试验" Width="380" Height="620"
        WindowStyle="None" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False"
        Background="#0B0B0E" AllowsTransparency="False">
    <Border CornerRadius="12" BorderThickness="2" BorderBrush="#757575" Background="#0B0B0E" Margin="4">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="36" CornerRadius="18" Background="#15151A" Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#A0A0AC"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                             Foreground="#F2F2F5" CaretBrush="#F2F2F5" VerticalAlignment="Center" Margin="6,0,10,0"
                             KeyDown="SearchBox_KeyDown"/>
                </Grid>
            </Border>
            <TextBlock x:Name="StateText" DockPanel.Dock="Bottom" Height="30" VerticalAlignment="Center"
                       Foreground="#7E7E8A" FontSize="10.5" Margin="16,0,16,0"
                       Text="P1 试验运行中…"/>
            <StackPanel Margin="12,4,12,8">
                <Border CornerRadius="12" BorderThickness="1" BorderBrush="#26262E" Background="#141419" Padding="16,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="第一条试验条目文字" Foreground="#F2F2F5" FontSize="13"/>
                        <TextBlock Text="记事本 · 刚刚" Foreground="#7E7E8A" FontSize="10.5" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" BorderThickness="1" BorderBrush="#26262E" Background="#141419" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="第二条试验条目文字" Foreground="#F2F2F5" FontSize="13"/>
                        <TextBlock Text="浏览器 · 3 分钟前" Foreground="#7E7E8A" FontSize="10.5" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
