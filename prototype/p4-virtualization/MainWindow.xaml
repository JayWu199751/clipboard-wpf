<Window x:Class="P4VirtualizationProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:P4VirtualizationProbe"
        Title="P4 虚拟化探针"
        Width="473" Height="945"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 卡片容器样式：与主工程 PanelWindow 相同的 Padding=0/模板化 Border 结构；
             InstanceId 附加属性在容器首次 realize 时分配（静态计数），
             distinct InstanceId 集合大小 = 实际创建的容器实例数 → Recycling 证据 -->
        <Style x:Key="CardContainerStyle" TargetType="ListBoxItem">
            <EventSetter Event="Loaded" Handler="OnCardContainerLoaded" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="#F5F5F5"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,12"
                                Margin="0,0,0,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#E3F0FF" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#4A90D9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- 搜索头占位（几何与主工程对齐：36 DIP 井） -->
        <Border Grid.Row="0" Height="36" Margin="12,0" VerticalAlignment="Center"
                Background="#EEEEEE" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="18" />

        <!-- 列表：与主工程 PanelWindow 同配置——虚拟化 + Recycling + Pixel 滚动单位、
             滚动条 Collapsed、上下留白 12/16（Margin 在滚动区外恒定存在：顶端保护留白、底部页脚分隔线上方间距） -->
        <ListBox x:Name="HistoryList"
                 Grid.Row="1"
                 Margin="12,12,12,16"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemContainerStyle="{StaticResource CardContainerStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionMode="Single">
            <ListBox.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Width" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
            </ListBox.Resources>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <!-- 图片卡缩略图：150 DIP 定高 -->
                        <Image Height="150"
                               Source="{Binding Thumb}"
                               Stretch="UniformToFill"
                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                        <!-- 正文最多三行裁剪（与主工程同参数） -->
                        <TextBlock Text="{Binding Body}"
                                   FontSize="13"
                                   LineHeight="20.15"
                                   LineStackingStrategy="BlockLineHeight"
                                   MaxHeight="60.45"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="#222222" />
                        <!-- meta 行：高 16 -->
                        <TextBlock Text="{Binding Meta}"
                                   Height="16"
                                   Margin="0,8,0,0"
                                   FontFamily="Consolas"
                                   FontSize="10.5"
                                   LineHeight="16"
                                   Foreground="#888888" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 页脚：顶部分隔线（判据 3 的「底部到页脚分隔线」即最后一张卡完整可见于此线之上） -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#CCCCCC" Background="#FAFAFA">
            <TextBlock x:Name="FooterText" Margin="16,0" VerticalAlignment="Center"
                       FontFamily="Consolas" FontSize="10.5" Foreground="#888888" Text="自检运行中…" />
        </Border>
    </Grid>
</Window>
