<Window x:Class="P5RoundedHitTest.TargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P5 下层靶窗" WindowStyle="SingleBorderWindow" ShowInTaskbar="False"
        Background="#FFF0F2F5" Topmost="True">
  <!-- Topmost：保证 z 序确定为「探针（Topmost，后显示）> 靶窗 > 其余应用窗口」，
       否则角外穿透会落到本会话控制台等普通窗口上，试验结果受环境影响 -->
  <Grid>
    <TextBlock Text="下层靶窗：探针角外的点击应当落到这里"
               FontSize="20" FontWeight="Bold" Foreground="#FF444444"
               HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock x:Name="ClickText" Text="已收到 0 次点击"
               FontSize="16" Foreground="#FFB3261E"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0" />
  </Grid>
</Window>
