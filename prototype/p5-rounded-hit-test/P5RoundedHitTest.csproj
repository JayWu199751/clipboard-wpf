<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>P5RoundedHitTest</RootNamespace>
    <AssemblyName>P5RoundedHitProbe</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- 几何纯函数归 P5Geometry 类库、单测归 tests/，均不进本工程通配 -->
  <ItemGroup>
    <Compile Remove="P5Geometry\**\*.cs;tests\**\*.cs" />
    <ProjectReference Include="P5Geometry\P5Geometry.csproj" />
  </ItemGroup>

</Project>
