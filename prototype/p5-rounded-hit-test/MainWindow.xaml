<Window x:Class="P5RoundedHitTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P5 圆角命中试验窗" Width="400" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
  <!-- 圆角外壳：与主工程 PanelWindow 同构（36 DIP 圆角 + 2 DIP 描边），
       尺寸缩小到 400×600 DIP 以便 175% 下完整落在单屏内；命中试验只关心角部几何。 -->
  <Border x:Name="Shell" CornerRadius="36" BorderThickness="2"
          BorderBrush="#FF5B8DEF" Background="#FFF7F8FA">
    <Grid x:Name="Rows" Margin="2" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- 搜索井（判据②：浏览态可点、输入态可聚焦键入） -->
      <Border x:Name="SearchWell" Grid.Row="0" Height="52" Margin="12,10,12,0"
              CornerRadius="10" Background="#FFEDEFF3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="搜索" FontSize="14" Foreground="#FF666666"
                     VerticalAlignment="Center" Margin="14,0,8,0" />
          <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="14" Margin="0,8,12,8"
                   VerticalContentAlignment="Center" IsReadOnly="True" BorderThickness="1"
                   BorderBrush="#FFCCCCCC" Background="White" />
        </Grid>
      </Border>

      <!-- 卡片区（判据②：点击选择） -->
      <StackPanel Grid.Row="1" Margin="12,10,12,10">
        <Border x:Name="Card1" Height="64" CornerRadius="8" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1">
          <TextBlock Text="卡片 1" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="Card2" Height="64" CornerRadius="8" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" Margin="0,8,0,0">
          <TextBlock Text="卡片 2（点我选中）" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="Card3" Height="64" CornerRadius="8" Background="White" BorderBrush="#FFDDDDDD" BorderThickness="1" Margin="0,8,0,0">
          <TextBlock Text="卡片 3" FontSize="14" Margin="14,0,0,0" VerticalAlignment="Center" />
        </Border>
      </StackPanel>

      <!-- 页脚（判据②：页脚可点；左侧状态行显示各区域计数） -->
      <Border x:Name="Footer" Grid.Row="2" Height="36" Background="#FFE9EBF0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Counters" Grid.Column="0" Text="井:0 卡:0 页脚:0 靶:0"
                     FontSize="11" Foreground="#FF888888" VerticalAlignment="Center" Margin="14,0,0,0" />
          <TextBlock Grid.Column="1" Text="页脚（点我）" FontSize="11" Foreground="#FF888888"
                     VerticalAlignment="Center" Margin="0,0,14,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
